# ============================================
# ELITE CHILE RP BOT - Variables de entorno
# ============================================
# Copia este archivo como .env y llena con tus datos reales

# 1. TOKEN DEL BOT (nunca lo subas a GitHub)
DISCORD_TOKEN=tu_token_aqui

# 2. CREDENCIALES DE LA APLICACIÓN (OAuth2)
CLIENT_ID=tu_client_id_aqui
CLIENT_SECRET=tu_client_secret_aqui

# 3. ID DEL SERVIDOR (Guild) - Para registro rápido de comandos
GUILD_ID=tu_guild_id_aqui

# Nota: Estas variables ya están preparadas en el código base.